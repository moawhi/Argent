# PostgreSQL connection string.
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://seeit:seeit@localhost:5432/seeit?schema=public"

# 32-byte key, base64 encoded, used for AES-256-GCM encryption of upstream API
# credentials at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every stored credential unreadable.
APP_MASTER_KEY=""

# Secret used to sign the argent_session login cookie (jose HS256).
# Generate with the same command as APP_MASTER_KEY. If unset, APP_MASTER_KEY
# is used as a fallback so local setups keep working.
SESSION_SECRET=""

# Optional. Comma separated list of hostnames the gateway is allowed to call.
# Leave empty to allow any host. Set this in production to prevent the gateway
# from being used as an open proxy.
GATEWAY_ALLOWED_HOSTS=""

# Where Argent itself is reachable. Used for the bundled demo mock URL and for
# email verification / password-reset links. Set to your public https URL in
# production (e.g. https://argent.example.com).
APP_URL="http://localhost:3000"

# Resend API key for verification and password-reset emails.
# Required in production. In development, if unset, links are shown in the UI.
# RESEND_API_KEY="re_xxxxxxxx"

# From address for Resend (must be a verified domain, or Resend's onboarding
# sender for smoke tests).
# EMAIL_FROM="Argent <onboarding@yourdomain.com>"

# Optional. Allow anyone to create an account at /signup (default: on).
# Set to false to require an admin to create users under Users.
# ALLOW_PUBLIC_SIGNUP="false"

# Optional. Role key for public sign-ups: client (default) | sales | dev (never admin).
# SIGNUP_DEFAULT_ROLE="client"

# Optional. Point the bundled sample spec at a real server instead of the
# mock API built into Argent.
# DEMO_API_BASE_URL="https://api.sample.example.com"
